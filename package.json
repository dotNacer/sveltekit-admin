{
  "name": "sveltekit-admin",
  "version": "0.3.0",
  "description": "Django-like admin panel for SvelteKit + Prisma + better-auth",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "npm run package",
    "package": "svelte-kit sync && svelte-package -o dist",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:gen": "prisma generate --schema tests/fixtures/prisma/schema.prisma",
    "test": "npm run test:gen && vitest run",
    "test:watch": "npm run test:gen && vitest",
    "test:coverage": "npm run test:gen && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "@sveltejs/kit": ">=2.0.0",
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "admin",
    "prisma",
    "better-auth",
    "crud",
    "dashboard",
    "admin-panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmusic-music/sveltekit-admin.git"
  },
  "homepage": "https://github.com/pmusic-music/sveltekit-admin#readme",
  "bugs": {
    "url": "https://github.com/pmusic-music/sveltekit-admin/issues"
  },
  "author": "pMusic"
}
