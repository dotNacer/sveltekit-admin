{
  "name": "sveltekit-admin",
  "version": "0.8.1",
  "description": "Django-like admin panel for SvelteKit + Prisma",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/server/adapters/drizzle/index.d.ts",
      "svelte": "./dist/server/adapters/drizzle/index.js",
      "default": "./dist/server/adapters/drizzle/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run package",
    "package": "svelte-kit sync && svelte-package -o dist",
    "prepublishOnly": "pnpm run package",
    "size": "pnpm run package && node scripts/package-size.mjs",
    "smoke:packaged": "node scripts/consumer-smoke.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:gen": "prisma generate --schema tests/fixtures/prisma/schema.prisma",
    "test": "svelte-kit sync && pnpm run test:gen && vitest run",
    "test:watch": "svelte-kit sync && pnpm run test:gen && vitest",
    "test:coverage": "svelte-kit sync && pnpm run test:gen && vitest run --coverage",
    "lint": "svelte-kit sync && eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run package && changeset publish"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "@sveltejs/kit": ">=2.0.0",
    "drizzle-orm": ">=0.32.0",
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "9",
    "@prisma/client": "^6.19.3",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "better-sqlite3": "12.9.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "admin",
    "prisma",
    "crud",
    "dashboard",
    "admin-panel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotNacer/sveltekit-admin.git"
  },
  "homepage": "https://github.com/dotNacer/sveltekit-admin#readme",
  "bugs": {
    "url": "https://github.com/dotNacer/sveltekit-admin/issues"
  },
  "author": "dotNacer"
}
