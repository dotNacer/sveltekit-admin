    <h1>Create Utilisateurs</h1>
    <div class="ska-card">
      <form method="POST" class="ska-form">
        <input type="hidden" name="_action" value="create">
    <div class="ska-field">
      <label class="ska-label">email *</label>
      <input type="text" name="email" value="" class="ska-input"  required>
    </div>
    <div class="ska-field">
      <label class="ska-label">name</label>
      <input type="text" name="name" value="" class="ska-input"  >
    </div>
    <div class="ska-field">
      <label class="ska-label">bio</label>
      <input type="text" name="bio" value="" class="ska-input"  >
    </div>
    <div class="ska-field">
      <label class="ska-label">rating</label>
      <input type="number" name="rating" value="" class="ska-input"  >
    </div>
        <div class="ska-field">
          <label class="ska-label">metadata</label>
          <textarea name="metadata" class="ska-input" rows="4"  ></textarea>
        </div>
    <div class="ska-field">
      <label class="ska-label">avatar</label>
      <input type="text" name="avatar" value="" class="ska-input"  >
    </div>
        <div class="ska-form__actions">
          <button type="submit" class="ska-btn ska-btn--primary">Create</button>
          <a href="/admin/user" class="ska-btn ska-btn--secondary">Cancel</a>
        </div>
      </form>
    </div>
    </main>
  </div>
</body>
</html>"
