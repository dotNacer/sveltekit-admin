              Post
            </a>
          </li>
          <li class="ska-nav__item">
            <a href="/admin/category" class="ska-nav__link ">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Category
            </a>
          </li>
        </ul>
      </nav>
    </aside>
    <main class="ska-main">
    <a href="/admin/user" class="ska-back">← Back to list</a>
    <h1>Edit Utilisateurs</h1>
    <p class="ska-subtitle">ID: 1</p>
    <div class="ska-card">
      <form method="POST" class="ska-form">
        <input type="hidden" name="_action" value="update">
    <div class="ska-field">
      <label class="ska-label">id</label>
      <input type="number" name="id" value="1" class="ska-input" readonly >
    </div>
    <div class="ska-field">
      <label class="ska-label">email *</label>
      <input type="text" name="email" value="user1@example.com" class="ska-input"  required>
    </div>
    <div class="ska-field">
      <label class="ska-label">name</label>
      <input type="text" name="name" value="User 1" class="ska-input"  >
    </div>
      <div class="ska-field">
        <label class="ska-label">bio</label>
        <textarea name="bio" class="ska-input" rows="4"  >Long bio with an apostrophe: o&#39;brien</textarea>
      </div>
    <div class="ska-field">
      <label class="ska-label">role</label>
      <input type="text" name="role" value="USER" class="ska-input"  >
    </div>
      <div class="ska-field">
        <label class="ska-checkbox-wrap">
          <input type="checkbox" name="isActive" class="ska-checkbox" checked >
          <span class="ska-label">is Active</span>
        </label>
      </div>
    <div class="ska-field">
      <label class="ska-label">balance</label>
      <input type="number" name="balance" value="10.50" class="ska-input"  >
    </div>
    <div class="ska-field">
      <label class="ska-label">visits</label>
      <input type="number" name="visits" value="3" class="ska-input"  >
    </div>
    <div class="ska-field">
      <label class="ska-label">rating</label>
      <input type="number" name="rating" value="4.5" class="ska-input"  >
    </div>
        <div class="ska-field">
          <label class="ska-label">metadata</label>
          <textarea name="metadata" class="ska-input" rows="4"  >{
  &quot;theme&quot;: &quot;dark&quot;
}</textarea>
        </div>
    <div class="ska-field">
      <label class="ska-label">avatar</label>
      <input type="text" name="avatar" value="" class="ska-input"  >
    </div>
    <div class="ska-field">
      <label class="ska-label">created At</label>
      <input type="datetime-local" name="createdAt" value="2026-01-15T10:30" class="ska-input" readonly >
    </div>
    <div class="ska-field">
      <label class="ska-label">updated At</label>
      <input type="datetime-local" name="updatedAt" value="2026-02-20T08:00" class="ska-input" readonly >
    </div>
        <div class="ska-form__actions">
          <button type="submit" class="ska-btn ska-btn--primary">Save Changes</button>
          <a href="/admin/user" class="ska-btn ska-btn--secondary">Cancel</a>
        </div>
      </form>
    </div>
    </main>
  </div>
</body>
</html>"
`;

