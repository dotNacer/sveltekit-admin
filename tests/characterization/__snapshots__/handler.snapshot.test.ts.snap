              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Post
            </a>
          </li>
          <li class="ska-nav__item">
            <a href="/admin/category" class="ska-nav__link ska-nav__link--active">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Category
            </a>
          </li>
        </ul>
      </nav>
    </aside>
    <main class="ska-main">
    <div class="ska-header">
      <div>
        <h1>Category</h1>
        <p class="ska-subtitle">0 records</p>
      </div>
      <a href="/admin/category/new" class="ska-btn ska-btn--primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
        Add Category
      </a>
    </div>
    <div class="ska-card">
      <div class="ska-table-wrap">
        <table class="ska-table">
          <thead>
            <tr>
              <th>slug</th><th>name</th><th>description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
              <tr><td colspan="4" style="text-align: center; color: #64748b; padding: 2rem;">No records found</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    </main>
  </div>
</body>
</html>"
`;

