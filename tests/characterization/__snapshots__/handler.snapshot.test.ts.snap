exports[`caractérisation du handler > 01 dashboard 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Admin</title>
  <style>
    :root {
      --ska-primary: #ff0055;
      --ska-primary-hover: #d9002f;
    }/* stripped: static CSS, see note */</style>
</head>
<body>
  <div class="ska-layout">
    <aside class="ska-sidebar">
      <a href="/admin" class="ska-logo">Test Admin</a>
      <nav>
        <ul class="ska-nav">
          <li class="ska-nav__item">
            <a href="/admin" class="ska-nav__link ska-nav__link--active">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
              Dashboard
            </a>
          </li>
          <li class="ska-nav__item">
            <a href="/admin/user" class="ska-nav__link ">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Utilisateurs
            </a>
          </li>
          <li class="ska-nav__item">
            <a href="/admin/post" class="ska-nav__link ">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Post
            </a>
          </li>
          <li class="ska-nav__item">
            <a href="/admin/category" class="ska-nav__link ">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg>
              Category
            </a>
          </li>
        </ul>
      </nav>
    </aside>
    <main class="ska-main">
    <h1>Dashboard</h1>
    <p class="ska-subtitle">Welcome to your admin panel</p>
    <div class="ska-stats">
      <div class="ska-stat">
        <div class="ska-stat__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/></svg>
        </div>
        <div>
          <div class="ska-stat__value">3</div>
          <div class="ska-stat__label">Models</div>
        </div>
      </div>
      <div class="ska-stat">
        <div class="ska-stat__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>
        </div>
        <div>
          <div class="ska-stat__value">26</div>
          <div class="ska-stat__label">Total Records</div>
        </div>
      </div>
    </div>
    <h2>Models</h2>
    <div class="ska-models">
        <a href="/admin/user" class="ska-model-card">
          <div>
            <div class="ska-model-card__name">Utilisateurs</div>
            <div class="ska-model-card__count">25 records</div>
          </div>
          <div class="ska-model-card__footer">Manage →</div>
        </a>
        <a href="/admin/post" class="ska-model-card">
          <div>
            <div class="ska-model-card__name">Post</div>
            <div class="ska-model-card__count">1 records</div>
          </div>
          <div class="ska-model-card__footer">Manage →</div>
        </a>
        <a href="/admin/category" class="ska-model-card">
          <div>
            <div class="ska-model-card__name">Category</div>
            <div class="ska-model-card__count">0 records</div>
          </div>
          <div class="ska-model-card__footer">Manage →</div>
        </a>
    </div>
    </main>
  </div>
</body>
</html>"
`;

