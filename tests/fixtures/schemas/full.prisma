datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Application user
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  bio       String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  balance   Decimal  @default(0)
  visits    BigInt   @default(0)
  rating    Float?
  metadata  Json?
  avatar    Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  // a regular comment, must be ignored
  @@index([email])
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String?
  published   Boolean    @default(false)
  publishedAt DateTime?
  authorId    Int
  /// The author of the post
  author      User       @relation(name: "AuthorPosts", fields: [authorId], references: [id])
  categories  Category[]
}

model Category {
  slug        String  @unique
  name        String
  description String?
  posts       Post[]
}

enum Role {
  USER
  ADMIN
  // a floating comment inside the enum body, must be filtered out
  MODERATOR
}
